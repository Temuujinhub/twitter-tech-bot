# Twitter API Credentials
# https://developer.twitter.com/en/portal/dashboard дээр олох
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_secret_here

# Bot Settings
POSTS_PER_DAY=5
MIN_HOUR=8
MAX_HOUR=23

# AI Settings (optional - Skycode LLM ашиглана)
# Танд өөрийн OpenAI key байвал энд оруулж болно
OPENAI_API_KEY=optional_your_openai_key

# News Sources
ENABLE_RSS=true
ENABLE_WEB_SCRAPING=true
ENABLE_TWITTER_MONITORING=false
